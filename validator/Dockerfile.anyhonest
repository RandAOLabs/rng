# Any-Honest validator: Node.js daemon plus native GMP puzzle cracker.
# Build from the repo root: docker build -f validator/Dockerfile.anyhonest .
# The image keeps the /app/provider layout (validator/ is copied there).
FROM node:22-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libgmp-dev && rm -rf /var/lib/apt/lists/*
COPY validator/cracker.c /src/cracker.c
RUN gcc -O2 -o /src/cracker /src/cracker.c -lgmp

FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgmp10 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY validator/package.json ./
COPY node_modules/@noble ./node_modules/@noble
COPY validator ./provider
COPY --from=build /src/cracker /usr/local/bin/rng-cracker
ENV RNG_CRACKER=/usr/local/bin/rng-cracker
# Unprivileged runtime. /data is the conventional dataDir mount; a host bind
# mount must be owned by uid 1000 (node), e.g. `chown -R 1000:1000 <dir>`.
RUN mkdir -p /data && chown node:node /data
USER node
ENTRYPOINT ["node"]
