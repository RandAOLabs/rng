diff --git a/scripts/vrf-test.Dockerfile b/scripts/vrf-test.Dockerfile
new file mode 100644
index 000000000..3c4cf3e0a
--- /dev/null
+++ b/scripts/vrf-test.Dockerfile
@@ -0,0 +1,19 @@
+# Test image for `vrf@1.0': this tree (src.tar from scripts/vrf-test.sh),
+# compiled with every native library, ready for `rebar3 device test'.
+FROM erlang:27
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      build-essential cmake git pkg-config libssl-dev libncurses-dev \
+      ca-certificates curl unzip \
+    && rm -rf /var/lib/apt/lists/*
+ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
+    PATH=/usr/local/cargo/bin:$PATH
+RUN curl -fsSL https://sh.rustup.rs \
+    | sh -s -- -y --profile minimal --default-toolchain stable
+COPY src.tar /src.tar
+RUN mkdir /app && tar -xf /src.tar -C /app && rm /src.tar
+WORKDIR /app
+# The Makefile's buildinfo needs a git HEAD; the archive has none.
+RUN git config --global user.email t@t && git config --global user.name t \
+    && git config --global --add safe.directory /app \
+    && git init -q && git add -A && git commit -qm vrf-test
+RUN rebar3 compile && test -f priv/blst_nif.so
diff --git a/scripts/vrf-test.sh b/scripts/vrf-test.sh
new file mode 100644
index 000000000..891029146
--- /dev/null
+++ b/scripts/vrf-test.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+# Build this tree in a container (erlang:27, with the blst NIF) and run the
+# `vrf@1.0' tests and the `lua@5.3a' tests next to them. Uncommitted changes
+# are included. An argument replaces the default `--devices' list, e.g.
+#   scripts/vrf-test.sh dev_vrf
+set -euo pipefail
+cd "$(dirname "$0")/.."
+DEVICES="${1:-dev_vrf,dev_lua}"
+SUBMODULES="native/lib/secp256k1 native/lib/blst"
+git submodule update --init $SUBMODULES
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+# Snapshot the working tree through a copy of the index, so ignored files
+# stay out, then append each submodule. Archives are written with LF line
+# endings whatever the host's `core.autocrlf'.
+cp "$(git rev-parse --git-path index)" "$tmp/index"
+tree="$(GIT_INDEX_FILE="$tmp/index" sh -c 'git add -A && git write-tree')"
+git -c core.autocrlf=false archive --format=tar -o "$tmp/src.tar" "$tree"
+for sm in $SUBMODULES; do
+    git -C "$sm" -c core.autocrlf=false archive --format=tar \
+        --prefix="$sm/" -o "$tmp/sm.tar" HEAD
+    tar -Af "$tmp/src.tar" "$tmp/sm.tar"
+done
+cp scripts/vrf-test.Dockerfile "$tmp/Dockerfile"
+docker build -t hb-vrf-test "$tmp"
+docker run --rm hb-vrf-test rebar3 device test --devices "$DEVICES"
diff --git a/src/core/lib/blst_nif.erl b/src/core/lib/blst_nif.erl
new file mode 100644
index 000000000..f8e79cf2a
--- /dev/null
+++ b/src/core/lib/blst_nif.erl
@@ -0,0 +1,24 @@
+%%% @doc BLS12-381 signature verification over the `blst' library
+%%% (supranational/blst, `native/lib/blst'), through `native/blst_nif'.
+%%%
+%%% The scheme is the IETF BLS signature "minimal-pubkey-size" variant:
+%%% public keys are compressed G1 points (48 bytes), signatures are compressed
+%%% G2 points (96 bytes), and messages hash to G2 with the ciphersuite
+%%% `BLS_SIG_BLS12381G2_XMD:SHA-256_SSWU_RO_NUL_'. A threshold group signature
+%%% verifies the same way under the group public key.
+-module(blst_nif).
+-export([verify/3]).
+
+-on_load(init/0).
+
+init() ->
+	PrivDir = code:priv_dir(hb),
+	ok = erlang:load_nif(filename:join([PrivDir, "blst_nif"]), 0).
+
+%% @doc Verify `Signature' over `Message' under `PublicKey'. Both points must
+%% decode, lie on the curve and in their prime-order subgroup, and the key
+%% must not be the identity; otherwise `{error, Reason}' names the failed
+%% check. Runs on a dirty CPU scheduler.
+-spec verify(binary(), binary(), binary()) -> boolean() | {error, atom()}.
+verify(_PublicKey, _Message, _Signature) ->
+	erlang:nif_error(nif_not_loaded).
